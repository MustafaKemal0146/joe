# Yalnız yerel Docker kurulumu için örnek değerlerdir.
# Gerçek API anahtarları buraya yazılmaz; Joe arayüzünden şifreli kasaya eklenir.
JOE_POSTGRES_PASSWORD=joe-local-only
JOE_MINIO_USER=joe
JOE_MINIO_PASSWORD=joe-local-storage
JOE_MINIO_CONSOLE_PORT=9002
JOE_WEB_PORT=4177
# Analiz ekranında taranacak tek ana dizin. Docker bu dizini /imports altına
# salt-okunur bağlar; içerik Joe veri alanına kopyalanmaz.
JOE_IMPORT_PATH=./imports
